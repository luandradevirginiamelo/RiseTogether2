<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissões para acessar arquivos e galeria -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK" />



    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Risetogether"
        tools:targetApi="31">


        <service
            android:name=".MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>


        <service
            android:name=".MyFirebaseMessagingService"
            android:exported="false"
            tools:ignore="WrongManifestParent">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>

        <!-- Splash Screen: First screen to open -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Risetogether.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Risetogether"/>

        <activity android:name=".Patient.ProvideFeedbackRatingsDetailScreen" />

        <!-- Patient Login Screen -->
        <activity
            android:name=".PatientLoginScreen"
            android:exported="true"
            android:label="Patient Login"
            android:theme="@style/Theme.Risetogether"/>

        <!-- Doctors Login Screen -->
        <activity
            android:name=".Doctor.DoctorLoginScreen"
            android:exported="true"
            android:label="Doctor Login"
            android:theme="@style/Theme.Risetogether"/>

        <!-- Caregiver Login Screen -->
        <activity
            android:name=".VolunteerLoginScreen"
            android:exported="true"
            android:label="Volunteer Login"
            android:theme="@style/Theme.Risetogether"/>

        <!-- Register Screen -->
        <activity
            android:name=".Doctor.RegisterPatientTreatment"
            android:exported="true"
            android:label="Register"
            android:theme="@style/Theme.Risetogether"/>

        <activity
            android:name=".Doctor.RegisterVolunteeringCancerSurvivor"
            android:exported="true"
            android:label="Register"
            android:theme="@style/Theme.Risetogether"/>

        <!-- Reset Password Screen -->
        <activity
            android:name=".ResetPasswordScreen"
            android:exported="true"
            android:label="Reset Password"
            android:theme="@style/Theme.Risetogether"/>

        <activity
            android:name=".ResetPasswordVolunteerScreen"
            android:exported="true"
            android:label="Volunteer Reset Password"
            android:theme="@style/Theme.Risetogether"/>

        <activity
            android:name=".ResetPasswordDoctorScreen"
            android:exported="true"
            android:label="Volunteer Reset Password"
            android:theme="@style/Theme.Risetogether"/>

        <activity
            android:name=".Doctor.DoctorDashboardScreen"
            android:exported="true"
            android:label="Doctor Dashboard"
            android:theme="@style/Theme.Risetogether"/>

        <activity
            android:name=".Patient.PatientDashboardScreen"
            android:exported="true"
            android:label="Doctor Dashboard"
            android:theme="@style/Theme.Risetogether"/>

        <activity
            android:name=".Patient.PatientinTreatmentProfile"
            android:exported="true"
            android:label="Doctor Dashboard"
            android:theme="@style/Theme.Risetogether"/>

        <activity android:name=".Patient.ViewListVolunteersScreen"
            android:exported="true"
            android:label="Doctor Dashboard"
            android:theme="@style/Theme.Risetogether"/>

        <activity android:name=".Patient.SendRequestSelectedAssistanceTask"
            android:exported="true"
            android:label="Send Request"
            android:theme="@style/Theme.Risetogether" />


        <activity android:name=".Patient.ViewDetailsSelectedVolunteer"
            android:exported="true"
            android:label="Doctor Dashboard"
            android:theme="@style/Theme.Risetogether"/>

        <activity android:name=".Patient.ViewNotificationsRemindersScreen"
            android:exported="true"
            android:label="Patient Dashboard"
            android:theme="@style/Theme.Risetogether" />

        <activity android:name=".Patient.ProvideFeedbackRatingsScreen"
            android:exported="true"
            android:label="Patient Dashboard"
            android:theme="@style/Theme.Risetogether" />



        <activity android:name=".Volunteer.VolunteerDashboardScreen"
            android:exported="true"
            android:label="Doctor Dashboard"
            android:theme="@style/Theme.Risetogether"/>

        <activity android:name=".Volunteer.ViewPatientRequestsScreen"
            android:exported="true"
            android:label="Doctor Dashboard"
            android:theme="@style/Theme.Risetogether"/>

        <activity android:name=".Volunteer.VolunteerProfileScreen"
            android:exported="true"
            android:label="Doctor Dashboard"
            android:theme="@style/Theme.Risetogether"/>

        <activity android:name=".Volunteer.ViewFeedbackRatingsScreen"
            android:exported="true"
            android:label="Doctor Dashboard"
            android:theme="@style/Theme.Risetogether"/>

        <activity android:name=".Volunteer.CreateProfileCalendarScheduleActivity"
            android:exported="true"
            android:label="Create Profile Calendar"
            android:theme="@style/Theme.Risetogether"/>






    </application>

</manifest>
